---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description,
  image = "https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1200&h=630&q=80",
  type = "website",
  noindex = false,
} = Astro.props;

const origin = "https://www.freshnails.pl";
const path = Astro.url.pathname;
const canonical = new URL(path, origin).href;
const year = new Date().getFullYear();

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Fresh Nails",
  url: origin + "/",
  inLanguage: "pl-PL",
  description: "Notes o kształcie płytki, kolorze, skórkach i przerwie od lakieru.",
  potentialAction: {
    "@type": "SearchAction",
    target: origin + "/w-studio/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};

const nav = [
  { href: "/paznokcie/", label: "Paznokcie" },
  { href: "/wzory/", label: "Wzory" },
  { href: "/slownik/", label: "Słownik" },
  { href: "/przed-wizyta/", label: "Przed wizytą" },
  { href: "/w-studio/", label: "Szukaj" },
  { href: "/o-nas/", label: "Studio" },
  { href: "/kontakt/", label: "Napisz" },
];

function isCurrent(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href);
}
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f7f3f5" />
    <meta property="og:site_name" content="Fresh Nails" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@420;560;650&family=Instrument+Serif&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script is:inline>if(location.hostname==="freshnails.pl")location.replace(location.href.replace("://","://www."));</script>
  </head>
  <body class="font-sans antialiased">
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <header class="border-b border-[var(--line)] backdrop-blur-sm">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-5">
        <a href="/" class="font-display text-4xl leading-none tracking-tight text-[var(--ink)]">
          Fresh<span class="text-[var(--blush-deep)]">.</span>
        </a>
        <nav class="site-nav flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="Główne">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="tresc">
      <slot />
    </main>
    <footer class="mt-20 bg-[var(--ink)] text-[var(--paper)]">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 md:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="font-display text-3xl">Fresh Nails</p>
          <p class="mt-3 max-w-md text-sm leading-relaxed opacity-75">
            Kształt, kolor, skórki. Paznokcie opisane z fotela przy oknie, nie z katalogu trendów.
          </p>
          <p class="mt-4 text-xs opacity-55">© {year} Fresh Nails · Gdańsk</p>
        </div>
        <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Stopka">
          <a href="/paznokcie/">Archiwum</a>
          <a href="/slownik/">Słownik</a>
          <a href="/przed-wizyta/">Przed wizytą</a>
          <a href="/o-nas/">O nas</a>
          <a href="/kontakt/">Kontakt</a>
          <a href="/polityka-prywatnosci/">Prywatność</a>
        </nav>
      </div>
    </footer>
    <div id="pasek-fresh-nails" style="position:fixed;top:0;left:0;height:3px;width:0;background:#9a5f70;z-index:40;pointer-events:none"></div>
    <script>
      const pasek = document.getElementById("pasek-fresh-nails");
      addEventListener("scroll", () => {
        const node = document.documentElement;
        const max = node.scrollHeight - node.clientHeight;
        if (pasek) pasek.style.width = (max > 0 ? (node.scrollTop / max) * 100 : 0) + "%";
      }, { passive: true });
    </script>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"cb200bad8b04453eab7b38c79e13ac9e"}'></script>
    <script defer src="https://umami-pink-phi.vercel.app/script.js" data-website-id="c1723045-26e6-41ea-8504-1908b4b1703f" data-domains="freshnails.pl,www.freshnails.pl"></script>
  </body>
</html>
