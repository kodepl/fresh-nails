---
import { getCollection } from "astro:content";
import Shell from "../layouts/Shell.astro";

const posts = (await getCollection("paznokcie")).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const lead = posts[0];
const rest = posts.slice(1, 7);

const dzialy = [...new Set(posts.map((post) => post.data.category).filter(Boolean))].map((name) => ({
  name,
  slug: String(name).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/ł/g, "l").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
}));
---
<Shell
  title="Fresh Nails | kształt, kolor, skórki"
  description="Portal o paznokciach: kształt płytki, french, hybryda i przerwa od lakieru. Fresh Nails, Gdańsk."
  image="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1200&h=630&q=80"
>
  <section class="hero-plane">
    <img
      src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1600&h=1200&q=80"
      alt="Dłonie i lakier. Motyw koloru, nie cennik."
      width="1600"
      height="1200"
      fetchpriority="high"
    />
    <div class="mx-auto flex h-full max-w-6xl flex-col justify-end px-5 py-16 md:justify-center md:py-24">
      <p class="text-xs uppercase tracking-[0.28em] text-[var(--blush-deep)]">Fresh Nails · Gdańsk</p>
      <h1 class="mt-4 max-w-xl font-display text-5xl leading-[0.95] text-[var(--ink)] md:text-7xl">
        Fresh Nails
      </h1>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-[var(--ink-soft)]">
        Kształt na krótkiej płytce, french bez muzeum i tydzień po ściągnięciu hybrydy. Pisane z fotela przy oknie.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="bg-[var(--ink)] px-5 py-3 text-sm text-[var(--paper)]" href="/paznokcie/">Czytaj archiwum</a>
        <a class="border border-[var(--line)] bg-white/70 px-5 py-3 text-sm backdrop-blur" href="/przed-wizyta/">Checklista przed wizytą</a>
      </div>
    </div>
  </section>

  {lead && (
    <a href={`/paznokcie/${lead.slug}/`} class="mx-auto grid max-w-6xl items-center gap-8 px-5 py-14 md:grid-cols-[1fr_1.15fr]">
      <img src={lead.data.image} alt="" class="h-64 w-full object-cover md:h-80" width="900" height="640" loading="lazy" />
      <div>
        <p class="text-xs uppercase tracking-[0.22em] text-[var(--blush-deep)]">{lead.data.category}</p>
        <h2 class="mt-2 font-display text-4xl leading-tight md:text-5xl">{lead.data.title}</h2>
        <p class="mt-4 text-[var(--ink-soft)]/85">{lead.data.description}</p>
      </div>
    </a>
  )}

  <section class="mx-auto max-w-6xl px-5 pb-6">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-[var(--line)] pb-4">
      <h2 class="font-display text-3xl">Ostatnio na stoliku</h2>
      <a class="text-sm underline-offset-2 hover:underline" href="/paznokcie/">Całe archiwum</a>
    </div>
    <ul class="mt-2 divide-y divide-[var(--line)]">
      {rest.map((post) => (
        <li>
          <a class="grid gap-2 py-5 sm:grid-cols-[7rem_1fr] sm:items-baseline" href={`/paznokcie/${post.slug}/`}>
            <span class="text-xs uppercase tracking-widest text-[var(--blush-deep)]">{post.data.category}</span>
            <span class="font-display text-2xl leading-tight md:text-3xl">{post.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-5 py-12 md:grid-cols-2">
    <a class="border border-[var(--line)] bg-white/60 p-6" href="/slownik/">
      <p class="text-xs uppercase tracking-[0.2em] opacity-60">Narzędzie</p>
      <h2 class="mt-2 font-display text-3xl">Słownik płytki</h2>
      <p class="mt-3 text-sm leading-relaxed opacity-75">Hybryda, odrost, top, french baby. Krótkie definicje bez żargonu z katalogu.</p>
    </a>
    <a class="border border-[var(--line)] bg-white/60 p-6" href="/przed-wizyta/">
      <p class="text-xs uppercase tracking-[0.2em] opacity-60">Narzędzie</p>
      <h2 class="mt-2 font-display text-3xl">Przed wizytą</h2>
      <p class="mt-3 text-sm leading-relaxed opacity-75">Interaktywna checklista: zdjęcie, odrost, alergie, czas na regenerację.</p>
    </a>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.22em] opacity-60">Działy</p>
        <h2 class="mt-1 font-display text-4xl">Wzory</h2>
      </div>
      <a class="text-sm underline-offset-2 hover:underline" href="/wzory/">Wszystkie działy</a>
    </div>
    <div class="mt-6 flex flex-wrap gap-2">
      {dzialy.map((item) => (
        <a class="border border-[var(--line)] bg-white/50 px-3 py-2 text-sm hover:bg-white" href={`/wzory/${item.slug}/`}>{item.name}</a>
      ))}
    </div>
  </section>
</Shell>
